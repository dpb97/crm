{
    // ---- Python ---------------------------------------------------------
    // Default is the upstream devcontainer layout. When using Remote-WSL,
    // pick /home/dboeckle/frappe-bench/env/bin/python via the interpreter
    // selector — this setting is a fallback.
    "python.defaultInterpreterPath": "frappe-bench/env/bin/python",
    "python.analysis.extraPaths": [
        "frappe-bench/apps/frappe",
        "frappe-bench/apps/erpnext",
        "frappe-bench/apps/crm",
        "frappe-bench/apps/lcs_integrations",
        "frappe-bench/apps/lcs_bizcard"
    ],
    "python.analysis.typeCheckingMode": "basic",
    "python.terminal.activateEnvironment": false,

    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
        }
    },

    // ---- JS / Vue / TS --------------------------------------------------
    "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[vue]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "[jsonc]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
    "eslint.workingDirectories": [
        { "directory": "frontend", "changeProcessCWD": true }
    ],
    "vue.server.hybridMode": true,

    // ---- Tailwind (LCS tokens like bg-lcs-primary) ----------------------
    "tailwindCSS.includeLanguages": {
        "vue": "html",
        "vue-html": "html"
    },
    "tailwindCSS.experimental.classRegex": [
        ["class\\s*[:=]\\s*\"([^\"]*)\""],
        ["class\\s*[:=]\\s*'([^']*)'"]
    ],

    // ---- File associations ---------------------------------------------
    // Frappe www pages mix Jinja with HTML.
    "files.associations": {
        "**/www/**/*.html": "jinja-html",
        "**/templates/**/*.html": "jinja-html",
        "**/templates/**/*.txt": "jinja"
    },
    "files.exclude": {
        "**/__pycache__": true,
        "**/*.pyc": true,
        "**/.pytest_cache": true,
        "**/.ruff_cache": true,
        "**/dist": true
    },
    "files.watcherExclude": {
        "**/frappe-bench/**": true,
        "**/node_modules/**": true,
        "**/__pycache__/**": true
    },

    // ---- Editor basics --------------------------------------------------
    "editor.formatOnSave": true,
    "editor.rulers": [88, 100],
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.eol": "\n",
    "files.insertFinalNewline": true,
    "files.trimFinalNewlines": true,
    "files.trimTrailingWhitespace": true,

    // ---- Misc -----------------------------------------------------------
    "debug.node.autoAttach": "disabled",
    "git.detectSubmodules": true,
    "terminal.integrated.defaultProfile.windows": "PowerShell",

    "sqltools.connections": [
        {
            "mysqlOptions": { "authProtocol": "default" },
            "previewLimit": 50,
            "server": "mariadb",
            "port": 3306,
            "driver": "MariaDB",
            "name": "MariaDB",
            "username": "root",
            "password": "123"
        }
    ]
}
