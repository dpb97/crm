# LCS CRM · Production configuration (cloud VM).
# cp .env.prod.example .env && chmod 600 .env — never commit .env.
# Secrets langfristig aus Azure Key Vault ziehen (siehe Runbook §6).

# ---- Image + Site ----
CRM_IMAGE=lcs-crm:latest
SITE_NAME=crm.lcs-group.com
ADMIN_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-strong-too

# ---- Microsoft Entra ID — EINE App-Registrierung fuer SSO + Mail-Sync ----
# Der Code (msal_sso + outlook_sync/graph_client) liest genau diese drei
# Variablen. Die App-Registrierung braucht daher BEIDE Permission-Typen:
#   Delegated:   openid, profile, email, offline_access, User.Read  (SSO)
#   Application: Mail.Read + Admin-Consent                          (Mail-Sync)
# Setup: docs/operations/entra-app-registration.md
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
