# LCS CRM · local development configuration template.
# Copy to `.env` and fill — `.env` is gitignored. Production pulls these
# from Azure Key Vault and injects them as container env vars.

# ------------------------------------------------------------------
# Frappe / site
# ------------------------------------------------------------------
FRAPPE_SITE_NAME=crm.lcs.local
FRAPPE_ADMIN_PASSWORD=change-me-in-dev-only
FRAPPE_ENCRYPTION_KEY=change-me-32-bytes-base64-please

# ------------------------------------------------------------------
# PostgreSQL 16 (per ADR 0002)
# ------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=crm
POSTGRES_USER=frappe
POSTGRES_PASSWORD=change-me

# ------------------------------------------------------------------
# Microsoft Entra ID (SSO) — see docs/operations/entra-app-registration.md
# ------------------------------------------------------------------
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# Where the app lives; used as redirect URI base.
ENTRA_REDIRECT_BASE=http://localhost:8000

# ------------------------------------------------------------------
# Microsoft Graph (Outlook delta sync)
# ------------------------------------------------------------------
# Same tenant as Entra; can be a distinct app registration with
# Mail.Read + Mail.ReadBasic.All (application) consented.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ------------------------------------------------------------------
# abas ERP bridge
# ------------------------------------------------------------------
ABAS_BASE_URL=https://abas.lcs.internal
ABAS_HMAC_KEY=rotate-quarterly-please
# Optional public URL pattern exposed to the frontend (AbasDeepLink.vue).
ABAS_WEB_BASE=https://abas.lcs.internal

# ------------------------------------------------------------------
# Proxess DMS
# ------------------------------------------------------------------
PROXESS_BASE_URL=https://proxess.lcs.internal
PROXESS_CLIENT_ID=
PROXESS_CLIENT_SECRET=
PROXESS_TOKEN_URL=https://proxess.lcs.internal/oauth/token

# ------------------------------------------------------------------
# E2E tests (Playwright)
# ------------------------------------------------------------------
LCS_CRM_BASE_URL=http://localhost:8000
